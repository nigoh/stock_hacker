{
  "permissions": {
    "allow": [
      "Bash(pip install -r requirements.txt)",
      "Bash(python3 scripts/:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 analysis/:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session_start.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_knowledge_index.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_report_disclaimer.py\""
          }
        ]
      }
    ]
  }
}
